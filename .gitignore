# =============================================================================
# DirectKV — .gitignore
# =============================================================================

# Virtual environment (created by Step 1 of the AE guide)
ae_python/

# Model weights (too large for git; see README.md Step 6)
# Listed twice: `weights` catches a symlink (created by Step 6 Option A),
# `weights/` catches a real directory (created by Step 6 Option B).
weights
weights/

# Benchmark results and logs (generated by tests/ae_reviewer.sh)
results/

# =============================================================================
# Python build artifacts
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-wheel-metadata/

# =============================================================================
# Compiled test binaries (generated by tests/build_and_test.sh)
# =============================================================================
# The CUDA standalone test compiles to a binary with no extension
tests/test_directkv_cpu_kv

# =============================================================================
# Neo / SwiftLLM generated files
# =============================================================================
# CPU-kernel profiling data created on first Neo server start
baseline/neo/profile_results/

# NOTE: baseline/neo/csrc/swiftllm_c.*.so  IS tracked — it is the pre-compiled
#       aarch64 C extension required by Neo at runtime.
# NOTE: baseline/neo/pacpu/prebuilt/*.so   IS tracked — pre-built ARM pacpu libs.

# =============================================================================
# CUDA JIT cache (written to ~/.cache by PyTorch, but guard against local spill)
# =============================================================================
*.cubin
*.ptx
torch_extensions/

# =============================================================================
# Editor / OS
# =============================================================================
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
